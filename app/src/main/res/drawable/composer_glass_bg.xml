<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF111C28" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#3A79A8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0E1721" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#263A4D" />
        </shape>
    </item>
</selector>
