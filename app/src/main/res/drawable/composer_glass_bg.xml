<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#B817202B" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#3A6F98" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B80C141D" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#263A4D" />
        </shape>
    </item>
</selector>
