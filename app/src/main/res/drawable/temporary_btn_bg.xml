<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active state: same blue, same "just a ring" rule — only the stroke gets a
         touch heavier so it's clearly "on" without introducing a second color or fill. -->
    <item android:state_activated="true">
        <ripple android:color="@color/hover_tint">
            <item>
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1.6dp" android:color="@color/blue_glow" />
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <ripple android:color="@color/hover_tint">
            <item>
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/blue_glow" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
