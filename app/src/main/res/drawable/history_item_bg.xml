        <shape android:shape="rectangle"><solid android:color="#0E131A" /><corners android:radius="13dp" /></shape>
    </item>
    <item>
        <ripple android:color="@color/hover_tint">
            <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /><corners android:radius="13dp" /></shape></item>
        </ripple>
    </item>
</selector>
