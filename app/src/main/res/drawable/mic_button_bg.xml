<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/hover_tint">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/blue_deep" />
                </shape>
            </item>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/glow_halo" />
                    <stroke android:width="1.3dp" android:color="@color/blue_glow" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
