<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#F00D1118" />
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="@color/line_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F00D1118" />
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="@color/line_composer" />
        </shape>
    </item>
</selector>
