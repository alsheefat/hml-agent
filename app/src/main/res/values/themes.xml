<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dropped ".DayNight" on purpose: this app has one fixed dark look, it should never
         flip to a light variant based on system settings. That DayNight gap was also why
         standard Material components (AlertDialog) fell back to MaterialComponents' light
         defaults — colorSurface/colorOnSurface were never told what this app's dark palette
         is, so a dialog would render as a plain light-gray box with sharp-ish corners even
         though every hand-built screen elsewhere in the app looks correctly dark. -->
    <style name="Theme.HMLAgent" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/blue_deep</item>
        <item name="colorPrimaryDark">@color/bg_black</item>
        <item name="colorAccent">@color/blue_bright</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_black</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorControlHighlight">@color/hover_tint</item>
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.HMLAgent.AlertDialog</item>
        <!-- Themes the floating "Copy / Select all" toolbar that appears when selecting
             message text — otherwise it's Android's own default (light, unthemed) popup. -->
        <item name="android:actionModeBackground">@drawable/dialog_bg</item>
        <item name="android:actionModeStyle">@style/HMLAgent.ActionMode</item>
    </style>

    <style name="HMLAgent.ActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">@drawable/dialog_bg</item>
        <item name="titleTextStyle">@style/HMLAgent.ActionMode.Text</item>
    </style>

    <style name="HMLAgent.ActionMode.Text" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Every MaterialAlertDialogBuilder(this) in the app (rename, delete confirm, the
         autonomous-control status dialog, its nested log-out confirm, and edit-profile)
         picks this up automatically — one fix covers all five. Must be
         MaterialAlertDialogBuilder specifically: plain AlertDialog.Builder never reads
         this attribute at all, which is why an earlier attempt at this silently did nothing. -->
    <style name="ThemeOverlay.HMLAgent.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/blue_bright</item>
        <item name="materialAlertDialogTitleTextStyle">@style/HMLAgent.AlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/HMLAgent.AlertDialog.Body</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.HMLAgent.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/HMLAgent.AlertDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/HMLAgent.AlertDialog.Button</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="colorControlActivated">@color/blue_bright</item>
        <item name="colorControlNormal">@color/text_muted</item>
    </style>

    <style name="ShapeAppearanceOverlay.HMLAgent.Dialog" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="HMLAgent.AlertDialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="HMLAgent.AlertDialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="HMLAgent.AlertDialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/blue_bright</item>
    </style>

    <!-- Quick-command chip on the home screen (concept: padding 13/12, radius 16, 2-col grid) -->
    <style name="CommandChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/chip_command_bg</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">13dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CommandChip.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#EDF3FA</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CommandChip.Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Tool pill under the composer: File / Voice / Temporary (concept: 34dp, radius 11) -->
    <style name="ToolPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">11dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/tool_pill_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ToolPill.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textColor">@color/text_tool</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TopIcon">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/icon_square_bg</item>
        <item name="android:padding">11dp</item>
        <item name="android:tint">@color/blue_glow</item>
    </style>

    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="TaskStepCheck">
        <item name="android:layout_width">15dp</item>
        <item name="android:layout_height">15dp</item>
        <item name="android:background">@drawable/check_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">#718094</item>
    </style>

    <style name="TaskStepLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#718094</item>
    </style>

    <style name="MinimalIconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/icon_square_bg</item>
        <item name="android:padding">9dp</item>
        <item name="android:tint">@color/text_icon</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ComposerIconButton">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/composer_icon_bg</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/text_icon</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="QuickAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">92dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/quick_action_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="QuickActionIcon">
        <item name="android:layout_width">25dp</item>
        <item name="android:layout_height">25dp</item>
        <item name="android:layout_gravity">center_horizontal|top</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:tint">@color/blue_glow</item>
    </style>

    <style name="QuickActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal|bottom</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:textColor">#8E9BAD</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NavItemCompact">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="TopTemporaryButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/top_temp_bg</item>
        <item name="android:padding">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TopNewChatButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/top_new_bg</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/blue_glow</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ComposerTemporaryButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/composer_temp_bg</item>
        <item name="android:padding">7dp</item>
        <item name="android:tint">@color/text_tool</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ComposerAttachButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/composer_attach_bg</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/text_icon</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ComposerVoiceButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/composer_voice_bg</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/blue_glow</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ComposerSendButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ConversationOptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ConversationOptionIcon">
        <item name="android:layout_width">19dp</item>
        <item name="android:layout_height">19dp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>
    <style name="ConversationOptionText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
