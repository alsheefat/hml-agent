<resources>
    <string name="app_name">HML Agent</string>

    <!-- ===================== OAuth config — fill these in yourself =====================
         Nothing below can be generated for you; each value comes from an account you control.

         GOOGLE: console.cloud.google.com -> APIs & Services -> Credentials
                 -> create an OAuth 2.0 "Web application" client
                 -> paste its Client ID below (this is the "server client ID" GoogleSignInOptions needs,
                    even though the app itself is Android — that's how Google's SDK works)
                 -> also register your app's SHA-1 signing fingerprint in that same console.

         FACEBOOK: developers.facebook.com -> My Apps -> your app -> Settings -> Basic
                   -> copy the App ID and Client Token below
                   -> add your Android key hash under Settings -> Basic -> Android platform.
         =================================================================================== -->
    <string name="default_web_client_id" translatable="false">REPLACE_WITH_GOOGLE_OAUTH_WEB_CLIENT_ID</string>
    <string name="facebook_app_id" translatable="false">REPLACE_WITH_FACEBOOK_APP_ID</string>
    <string name="facebook_client_token" translatable="false">REPLACE_WITH_FACEBOOK_CLIENT_TOKEN</string>
    <string name="fb_login_protocol_scheme" translatable="false">fbREPLACE_WITH_FACEBOOK_APP_ID</string>

