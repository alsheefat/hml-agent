<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ====================== Main content (HML Agent UI concept) ====================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/app_bg">

        <!-- Top bar: ☰  [H] HML Agent / ● ready   ◌  ＋ -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/menuButton"
                style="@style/TopIcon"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/recent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/brand_mark_bg"
                    android:gravity="center"
                    android:text="H"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/dot_good"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:text="@string/status_ready"
                            android:textColor="@color/text_dim"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.03" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/temporaryChatButton"
                style="@style/TopIcon"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_temp_ring"
                android:contentDescription="@string/temporary_chat" />

            <ImageButton
                android:id="@+id/newChatButton"
                style="@style/TopIcon"
                android:src="@drawable/ic_add"
                android:contentDescription="@string/new_chat" />
        </LinearLayout>

        <!-- Chat header: conversation title + TEMPORARY badge (concept's .chathead) -->
        <LinearLayout
            android:id="@+id/chatHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="19dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/new_conversation"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/temporaryBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/temp_badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:text="@string/temporary_badge"
                android:textColor="@color/blue_glow"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Message list (chat screen) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toBottomOf="@id/chatHeader"
            app:layout_constraintBottom_toTopOf="@id/composerContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Home screen: hero + real commands + autonomous-control card -->
        <ScrollView
            android:id="@+id/homeContentView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/chatHeader"
            app:layout_constraintBottom_toTopOf="@id/composerContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="26dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_eyebrow"
                        android:textColor="#5F7188"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:id="@+id/homeHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="@string/home_headline_1"
                        android:textColor="@color/text_primary"
                        android:textSize="42sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="-0.05"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="0.98" />

                    <TextView
                        android:id="@+id/homeHeadlineAccent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_headline_2"
                        android:textColor="@color/blue_glow"
                        android:textSize="42sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="-0.05"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="0.98" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/home_subtitle"
                        android:textColor="#7F8B9D"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/quick_commands_title"
                    android:textColor="#566376"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/chipFlashlight" style="@style/CommandChip" android:layout_marginEnd="4dp">
                        <TextView style="@style/CommandChip.Title" android:text="@string/chip_flashlight_title" />
                        <TextView style="@style/CommandChip.Subtitle" android:text="@string/chip_flashlight_sub" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/chipApps" style="@style/CommandChip" android:layout_marginStart="4dp">
                        <TextView style="@style/CommandChip.Title" android:text="@string/chip_apps_title" />
                        <TextView style="@style/CommandChip.Subtitle" android:text="@string/chip_apps_sub" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/chipMusic" style="@style/CommandChip" android:layout_marginEnd="4dp">
                        <TextView style="@style/CommandChip.Title" android:text="@string/chip_music_title" />
                        <TextView style="@style/CommandChip.Subtitle" android:text="@string/chip_music_sub" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/chipYoutube" style="@style/CommandChip" android:layout_marginStart="4dp">
                        <TextView style="@style/CommandChip.Title" android:text="@string/chip_youtube_title" />
                        <TextView style="@style/CommandChip.Subtitle" android:text="@string/chip_youtube_sub" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/chipReminder" style="@style/CommandChip" android:layout_marginEnd="4dp">
                        <TextView style="@style/CommandChip.Title" android:text="@string/chip_reminder_title" />
                        <TextView style="@style/CommandChip.Subtitle" android:text="@string/chip_reminder_sub" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/chipPhone" style="@style/CommandChip" android:layout_marginStart="4dp">
                        <TextView style="@style/CommandChip.Title" android:text="@string/chip_phone_title" />
                        <TextView style="@style/CommandChip.Subtitle" android:text="@string/chip_phone_sub" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:background="@drawable/info_card_bg"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/autonomous_control_title"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_bg"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="5dp"
                            android:text="@string/autonomous_control_badge"
                            android:textColor="#66BAFF"
                            android:textSize="9sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/autonomous_control_desc"
                        android:textColor="#6E7B8D"
                        android:textSize="10sp"
                        android:lineSpacingMultiplier="1.4" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Composer card + autonomous task card, stacked above the floating nav -->
        <LinearLayout
            android:id="@+id/composerContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Autonomous task card (shown while the on-screen agent is working) -->
            <LinearLayout
                android:id="@+id/taskCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:background="@drawable/task_card_bg"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/orb_bg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="@string/task_title"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/taskLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_live"
                        android:textColor="#53E7A2"
                        android:textSize="8sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <TextView
                    android:id="@+id/taskStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#AAB8C8"
                    android:textSize="10sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/taskCheck1" style="@style/TaskStepCheck" android:text="1" />
                <TextView android:id="@+id/taskLabel1" style="@style/TaskStepLabel" android:text="@string/task_step_1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/taskCheck2" style="@style/TaskStepCheck" android:text="2" />
                <TextView android:id="@+id/taskLabel2" style="@style/TaskStepLabel" android:text="@string/task_step_2" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/taskCheck3" style="@style/TaskStepCheck" android:text="3" />
                <TextView android:id="@+id/taskLabel3" style="@style/TaskStepLabel" android:text="@string/task_step_3" />
            </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/attachmentsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/attachmentsPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Glass composer: input + gradient send, tools row below -->
            <LinearLayout
                android:id="@+id/composerWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:orientation="vertical"
                android:background="@drawable/composer_bg"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/messageInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:background="@null"
                        android:hint="@string/message_hint"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="4"
                        android:inputType="textMultiLine|textCapSentences"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="12dp" />

                    <ImageButton
                        android:id="@+id/sendButton"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/send_btn_bg"
                        android:src="@drawable/ic_send"
                        android:tint="#FFFFFF"
                        android:padding="12dp"
                        android:contentDescription="@string/send" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/attachButton" style="@style/ToolPill">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp"
                            android:src="@drawable/ic_add" android:tint="@color/text_tool" android:contentDescription="@null" />
                        <TextView style="@style/ToolPill.Label" android:text="@string/tool_file" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/micButton" style="@style/ToolPill">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp"
                            android:src="@drawable/ic_mic" android:tint="@color/text_tool" android:contentDescription="@null" />
                        <TextView style="@style/ToolPill.Label" android:text="@string/tool_voice" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/temporaryPill" style="@style/ToolPill">
                        <ImageView android:id="@+id/temporaryPillIcon" android:layout_width="14dp" android:layout_height="14dp"
                            android:src="@drawable/ic_temp_ring" android:tint="@color/text_tool" android:contentDescription="@null" />
                        <TextView android:id="@+id/temporaryPillLabel" style="@style/ToolPill.Label" android:text="@string/tool_temporary_label" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Floating glass bottom navigation: Home / Chat / History -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:background="@drawable/bottom_nav_bg"
            android:elevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_nav_home" android:tint="@color/nav_item_tint"
                    android:duplicateParentState="true" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/nav_home" android:textSize="9sp"
                    android:textColor="@color/nav_item_tint" android:duplicateParentState="true" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navChat" style="@style/NavItem">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_nav_chat" android:tint="@color/nav_item_tint"
                    android:duplicateParentState="true" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/nav_chat" android:textSize="9sp"
                    android:textColor="@color/nav_item_tint" android:duplicateParentState="true" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navHistory" style="@style/NavItem">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_nav_history" android:tint="@color/nav_item_tint"
                    android:duplicateParentState="true" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/nav_history" android:textSize="9sp"
                    android:textColor="@color/nav_item_tint" android:duplicateParentState="true" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ====================== Drawer: recent conversations ====================== -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/drawer_panel_bg"
        android:paddingHorizontal="15dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        android:elevation="16dp"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="17dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/brand_mark_bg"
                android:gravity="center"
                android:text="H"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView android:layout_width="12dp" android:layout_height="12dp"
                        android:src="@drawable/dot_good" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="3dp" android:text="@string/status_local"
                        android:textColor="@color/text_dim" android:textSize="9sp" android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/drawerNewChat"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/new_chat_bg"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/drawer_new_chat"
            android:textColor="@color/blue_glow"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:layout_marginBottom="9dp"
            android:paddingHorizontal="5dp"
            android:text="@string/recent"
            android:textAllCaps="true"
            android:textColor="#556275"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/accountRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="11dp"
            android:background="@drawable/account_card_bg"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/avatar_bg">

                <TextView
                    android:id="@+id/accountInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="A"
                    android:textColor="#8FC8FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/accountGuestIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    android:tint="#8FC8FF"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/accountName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guest"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/accountSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Profile &amp; Autonomous Control"
                    android:textColor="#5F6C7E"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#526071"
                android:contentDescription="@null" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
