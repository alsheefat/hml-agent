<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/app_bg">

        <!-- Quiet, icon-led top bar. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/menuButton"
                style="@style/MinimalIconButton"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/recent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="12dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/hml_logo_clean"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/temporaryChatButton"
                style="@style/TopTemporaryButton"
                android:src="@drawable/ic_temp_hml"
                android:contentDescription="@string/temporary_chat" />

            <ImageButton
                android:id="@+id/newChatButton"
                style="@style/TopNewChatButton"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_new_chat_hml"
                android:contentDescription="@string/new_chat" />
        </LinearLayout>

        <!-- Stage 21: subtle top fade keeps scrolling content visually tucked under the header. -->
        <View
            android:id="@+id/topContentFade"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:background="@drawable/top_content_fade"
            android:clickable="false"
            android:focusable="false"
            android:elevation="3dp"
            app:layout_constraintTop_toBottomOf="@id/chatHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Conversation title appears only when it adds context. -->
        <LinearLayout
            android:id="@+id/chatHeader"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/temporaryBanner"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/temp_badge_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/temporary_badge"
                android:textColor="@color/blue_glow"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/chatHeader"
            app:layout_constraintBottom_toTopOf="@id/composerContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Empty state: one thought, six useful actions. -->
        <ScrollView
            android:id="@+id/homeContentView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/composerContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="52dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/homeHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_headline_1"
                    android:textColor="@color/text_primary"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:letterSpacing="-0.045"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/homeHeadlineAccent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/home_headline_2"
                    android:textColor="@color/blue_glow"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:letterSpacing="-0.045"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:maxWidth="310dp"
                    android:lineSpacingMultiplier="1.2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/chipFlashlight"
                            style="@style/QuickAction"
                            android:layout_marginEnd="5dp">
                            <ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_action_flash" android:contentDescription="@string/chip_flashlight_title" />
                            <TextView style="@style/QuickActionLabel" android:text="@string/chip_flashlight_title" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/chipApps"
                            style="@style/QuickAction"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp">
                            <ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_action_apps" android:contentDescription="@string/chip_apps_title" />
                            <TextView style="@style/QuickActionLabel" android:text="@string/chip_apps_title" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/chipMusic"
                            style="@style/QuickAction"
                            android:layout_marginStart="5dp">
                            <ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_action_music" android:contentDescription="@string/chip_music_title" />
                            <TextView style="@style/QuickActionLabel" android:text="@string/chip_music_title" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/chipYoutube"
                            style="@style/QuickAction"
                            android:layout_marginEnd="5dp">
                            <ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_action_youtube" android:contentDescription="@string/chip_youtube_title" />
                            <TextView style="@style/QuickActionLabel" android:text="@string/chip_youtube_title" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/chipReminder"
                            style="@style/QuickAction"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp">
                            <ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_action_reminder" android:contentDescription="@string/chip_reminder_title" />
                            <TextView style="@style/QuickActionLabel" android:text="@string/chip_reminder_title" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/chipPhone"
                            style="@style/QuickAction"
                            android:layout_marginStart="5dp">
                            <ImageView style="@style/QuickActionIcon" android:src="@drawable/ic_action_phone" android:contentDescription="@string/chip_phone_title" />
                            <TextView style="@style/QuickActionLabel" android:text="@string/chip_phone_title" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- This entire container is bottom-anchored. With adjustResize it moves with the IME,
             so the writing bar stays directly above the keyboard instead of being covered. -->
        <com.hmlai.agent.BlurBehindView
            android:id="@+id/composerBlur"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/composerContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/taskCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:background="@drawable/task_card_bg"
                android:padding="11dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/dot_good" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/task_title"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/taskLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_live"
                        android:textColor="#53E7A2"
                        android:textSize="8sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/taskStopButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/task_stop_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="@string/task_stop"
                        android:textColor="#FF8190"
                        android:textSize="8sp"
                        android:fontFamily="monospace"
                        android:contentDescription="@string/task_stop" />
                </LinearLayout>

                <TextView
                    android:id="@+id/taskStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#AAB8C8"
                    android:textSize="10sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/taskCheck1" style="@style/TaskStepCheck" android:text="1" />
                    <TextView android:id="@+id/taskLabel1" style="@style/TaskStepLabel" android:text="@string/task_step_1" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/taskCheck2" style="@style/TaskStepCheck" android:text="2" />
                    <TextView android:id="@+id/taskLabel2" style="@style/TaskStepLabel" android:text="@string/task_step_2" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/taskCheck3" style="@style/TaskStepCheck" android:text="3" />
                    <TextView android:id="@+id/taskLabel3" style="@style/TaskStepLabel" android:text="@string/task_step_3" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/attachmentsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="5dp"
                android:visibility="gone"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/attachmentsPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/composerWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/composer_glass_bg"
                android:paddingHorizontal="5dp"
                android:paddingVertical="4dp">

                <ImageButton
                    android:id="@+id/attachButton"
                    style="@style/ComposerAttachButton"
                    android:src="@drawable/ic_attach"
                    android:contentDescription="@string/attach_file" />

                <EditText
                    android:id="@+id/messageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:maxHeight="110dp"
                    android:background="@null"
                    android:hint="@string/message_hint"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:maxLines="4"
                    android:inputType="textMultiLine|textCapSentences"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="5dp" />

                <ImageButton
                    android:id="@+id/micButton"
                    style="@style/ComposerVoiceButton"
                    android:src="@drawable/ic_voice_wave"
                    android:contentDescription="@string/voice_input" />

                <ImageButton
                    android:id="@+id/sendButton"
                    style="@style/ComposerSendButton"
                    android:background="@drawable/send_btn_bg"
                    android:src="@drawable/ic_send"
                    android:tint="#FFFFFF"
                    android:contentDescription="@string/send" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Drawer remains the power-user/history surface, not part of the main visual noise. -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/drawer_panel_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:elevation="16dp"
        android:fitsSystemWindows="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/hml_logo_clean"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/drawerNewChat"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="0dp"
            android:background="@drawable/new_chat_bg"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/drawer_new_chat"
            android:textColor="@color/blue_glow"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:layout_marginBottom="8dp"
            android:text="@string/recent"
            android:textAllCaps="true"
            android:textColor="#556275"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="1dp" />

        <LinearLayout
            android:id="@+id/accountRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="11dp"
            android:background="@drawable/account_card_bg"
            android:clickable="true"
            android:focusable="true">
            <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/avatar_bg">
                <TextView android:id="@+id/accountInitial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="A" android:textColor="#8FC8FF" android:textSize="13sp" android:textStyle="bold" />
                <ImageView android:id="@+id/accountGuestIcon" android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:src="@drawable/ic_person" android:tint="#8FC8FF" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/accountName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Guest" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/accountSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Profile &amp; Autonomous Control" android:textColor="#5F6C7E" android:textSize="9sp" />
            </LinearLayout>
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron_right" android:tint="#526071" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
