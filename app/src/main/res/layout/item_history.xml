<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/historyRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:background="@drawable/history_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="11dp"
    android:paddingTop="8dp"
    android:paddingEnd="2dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/historyPinIcon"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginEnd="7dp"
        android:src="@drawable/ic_pin"
        android:tint="@color/blue_glow"
        android:visibility="gone"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/historyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/historyMoreButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/icon_btn_bg"
        android:padding="7dp"
        android:src="@drawable/ic_more"
        android:contentDescription="@string/conversation_options"
        android:tint="@color/text_secondary" />
</LinearLayout>
