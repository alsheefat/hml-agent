<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/historyRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/history_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="9dp">

    <ImageView
        android:layout_width="29dp"
        android:layout_height="29dp"
        android:background="@drawable/history_tile_bg"
        android:padding="7dp"
        android:src="@drawable/ic_history_tile"
        android:tint="#6BAEFF"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/historyPinIcon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_pin"
        android:tint="@color/blue_glow"
        android:visibility="gone"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/historyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#AEB8C7"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/historyMoreButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="7dp"
        android:src="@drawable/ic_more"
        android:contentDescription="@string/conversation_options"
        android:tint="#465365" />
</LinearLayout>
