<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="156dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_menu_bg"
    android:paddingVertical="6dp"
    android:elevation="12dp">

    <LinearLayout android:id="@+id/optionRename" style="@style/ConversationOptionRow">
        <ImageView style="@style/ConversationOptionIcon" android:src="@drawable/ic_option_rename" />
        <TextView style="@style/ConversationOptionText" android:text="Rename" />
    </LinearLayout>
    <LinearLayout android:id="@+id/optionPin" style="@style/ConversationOptionRow">
        <ImageView android:id="@+id/optionPinIcon" style="@style/ConversationOptionIcon" android:src="@drawable/ic_option_pin" />
        <TextView android:id="@+id/optionPinText" style="@style/ConversationOptionText" android:text="Pin" />
    </LinearLayout>
    <LinearLayout android:id="@+id/optionShare" style="@style/ConversationOptionRow">
        <ImageView style="@style/ConversationOptionIcon" android:src="@drawable/ic_option_share" />
        <TextView style="@style/ConversationOptionText" android:text="Share" />
    </LinearLayout>
    <LinearLayout android:id="@+id/optionShortcut" style="@style/ConversationOptionRow">
        <ImageView style="@style/ConversationOptionIcon" android:src="@drawable/ic_option_home" />
        <TextView style="@style/ConversationOptionText" android:text="Add to Home" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="12dp" android:background="@color/line" />

    <LinearLayout android:id="@+id/optionDelete" style="@style/ConversationOptionRow">
        <ImageView style="@style/ConversationOptionIcon" android:src="@drawable/ic_option_delete" />
        <TextView style="@style/ConversationOptionText" android:text="Delete" android:textColor="@color/color_error" />
    </LinearLayout>
</LinearLayout>
