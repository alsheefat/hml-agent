<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="130dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_menu_bg"
    android:paddingVertical="4dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/optionRename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rename_conversation"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/optionPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pin_conversation"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/optionShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_conversation"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/optionShortcut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_to_home_screen"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="3dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/optionDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_conversation"
        android:textColor="@color/color_error"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
